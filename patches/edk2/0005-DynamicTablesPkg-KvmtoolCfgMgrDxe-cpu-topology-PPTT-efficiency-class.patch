+/** Set the GicC Processor Power Efficiency Class from "capacity-dmips-mhz".
+
+  Each cpu gets the rank of its capacity among the distinct capacities, so
+  the slowest cores are class 0 and faster cores get higher classes. Without
+  this every core is class 0 and an ACPI-only guest (Windows) cannot tell the
+  big cores from the little ones. If any cpu node lacks the property, all
+  classes stay 0.
+
+  @param [in]       Fdt             Pointer to a Flattened Device Tree (Fdt).
+  @param [in]       CpusNode        Offset of a cpus node.
+  @param [in]       CpuCount        Number of cpu nodes.
+  @param [in, out]  GicCInfoBuffer  CM_ARM_GICC_INFO array, in cpu node order.
+**/
+STATIC
+VOID
+EFIAPI
+CpusEfficiencyClassParser (
+  IN      CONST VOID              *Fdt,
+  IN            INT32             CpusNode,
+  IN            UINT32            CpuCount,
+  IN  OUT       CM_ARM_GICC_INFO  *GicCInfoBuffer
+  )
+{
+  EFI_STATUS   Status;
+  CONST UINT8  *Data;
+  INT32        DataSize;
+  INT32        CpuNode;
+  UINT32       Index;
+  UINT32       Other;
+  UINT32       Prev;
+  UINT32       *Capacity;
+  UINT8        Class;
+
+  Capacity = AllocateZeroPool (CpuCount * sizeof (UINT32));
+  if (Capacity == NULL) {
+    return;
+  }
+
+  CpuNode = CpusNode;
+  for (Index = 0; Index < CpuCount; Index++) {
+    Status = FdtGetNextNamedNodeInBranch (Fdt, CpusNode, "cpu", &CpuNode);
+    if (EFI_ERROR (Status)) {
+      goto exit_handler;
+    }
+
+    Data = FdtGetProp (Fdt, CpuNode, "capacity-dmips-mhz", &DataSize);
+    if ((Data == NULL) || (DataSize != sizeof (UINT32))) {
+      goto exit_handler;
+    }
+
+    Capacity[Index] = Fdt32ToCpu (*(UINT32 *)Data);
+  }
+
+  for (Index = 0; Index < CpuCount; Index++) {
+    Class = 0;
+    for (Other = 0; Other < CpuCount; Other++) {
+      if (Capacity[Other] >= Capacity[Index]) {
+        continue;
+      }
+
+      // Count each smaller capacity value once.
+      for (Prev = 0; Prev < Other; Prev++) {
+        if (Capacity[Prev] == Capacity[Other]) {
+          break;
+        }
+      }
+
+      if (Prev == Other) {
+        Class++;
+      }
+    }
+
+    GicCInfoBuffer[Index].ProcessorPowerEfficiencyClass = Class;
+  }
+
+exit_handler:
+  FreePool (Capacity);
+}
