+  Status = AmlCreateLpiNode ("_LPI", 0, 0, CpuNode, &LpiNode);
+  if (EFI_ERROR (Status)) {
+    ASSERT (0);
+    return Status;
+  }
+
+  Status = AmlAddLpiState (
+             1,             // MinResidency (us)
+             1,             // WorstCaseWakeLatency (us)
