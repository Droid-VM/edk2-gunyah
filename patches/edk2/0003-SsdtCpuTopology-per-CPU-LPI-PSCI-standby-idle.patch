+             0,             // ResCntFreq
+             0,             // EnableParentState
+             &PsciLpiEntry, // Entry method: FFH register => PSCI CPU_SUSPEND
+             0,             // Integer entry method (unused)
+             NULL,          // ResidencyCounterRegister
+             NULL,          // UsageCounterRegister
+             "WFI",         // StateName
+             LpiNode
+             );
+  if (EFI_ERROR (Status)) {
