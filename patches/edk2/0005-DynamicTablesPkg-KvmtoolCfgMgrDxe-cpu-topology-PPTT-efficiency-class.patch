+/** Token of the Index-th CM_ARCH_COMMON_PROC_HIERARCHY_INFO created
+    by CpuMapParser.
+*/
+#define PROC_HIERARCHY_TOKEN(Index)  CM_ABSTRACT_TOKEN_MAKE (       \
+                                       ETokenNameSpaceFdtHwInfo,    \
+                                       EFdtHwInfoProcHierarchyObject, \
+                                       (Index)                      \
+                                       )
+
+/** PPTT processor flags: Package is the physical package bit, Leaf the
+    node-is-leaf bit. The ACPI processor ID is always valid.
+*/
+#define PROC_HIERARCHY_FLAGS(Package, Leaf)                         \
+          ((Package) | (EFI_ACPI_6_3_PPTT_PROCESSOR_ID_VALID << 1) | \
+           ((Leaf) << 3))
+
+/** Parse the "cpu-map" node of the "cpus" node.
+
+  Create one CM_ARCH_COMMON_PROC_HIERARCHY_INFO for the physical package,
+  one per "clusterN" node and one per "coreN" node, so that the PPTT and the
+  SSDT CPU topology describe which cpus share a cluster. Only a single level
+  of clusters whose cores reference one cpu each is supported; for any other
+  layout, or when there is no "cpu-map", nothing is created and the topology
+  stays flat.
+
+  @param [in]  FdtParserHandle  A handle to the parser instance.
+  @param [in]  CpusNode         Offset of a cpus node.
+  @param [in]  CpuCount         Number of cpu nodes.
+  @param [in]  GicCTokens       Token of the CM_ARM_GICC_INFO of each cpu
+                                node, in cpu node order.
+
+  @retval EFI_SUCCESS             The function completed successfully.
+  @retval EFI_OUT_OF_RESOURCES    An allocation has failed.
+**/
+STATIC
+EFI_STATUS
+EFIAPI
+CpuMapParser (
+  IN  CONST FDT_HW_INFO_PARSER_HANDLE  FdtParserHandle,
+  IN        INT32                      CpusNode,
+  IN        UINT32                     CpuCount,
+  IN  CONST CM_OBJECT_TOKEN            *GicCTokens
+  )
+{
+  EFI_STATUS                          Status;
+  VOID                                *Fdt;
+  INT32                               CpuMapNode;
+  INT32                               ClusterNode;
+  INT32                               CoreNode;
+  INT32                               CpuNode;
+  CONST UINT8                         *Data;
+  INT32                               DataSize;
+  UINT32                              Phandle;
+  UINT32                              *CpuPhandles;
+  BOOLEAN                             *Seen;
+  CM_ARCH_COMMON_PROC_HIERARCHY_INFO  *Nodes;
+  CM_ARCH_COMMON_PROC_HIERARCHY_INFO  *Node;
+  CM_OBJECT_TOKEN                     ClusterToken;
+  UINT32                              NodeCount;
+  UINT32                              MaxNodes;
+  UINT32                              Index;
+
+  Fdt = FdtParserHandle->Fdt;
+
+  CpuMapNode = FdtSubnodeOffset (Fdt, CpusNode, "cpu-map");
+  if (CpuMapNode < 0) {
+    return EFI_SUCCESS;
+  }
+
+  // One package, then at most CpuCount clusters and CpuCount cores.
+  MaxNodes    = 1 + 2 * CpuCount;
+  CpuPhandles = AllocateZeroPool (CpuCount * sizeof (UINT32));
+  Seen        = AllocateZeroPool (CpuCount * sizeof (BOOLEAN));
+  Nodes       = AllocateZeroPool (MaxNodes * sizeof (CM_ARCH_COMMON_PROC_HIERARCHY_INFO));
+  if ((CpuPhandles == NULL) || (Seen == NULL) || (Nodes == NULL)) {
+    Status = EFI_OUT_OF_RESOURCES;
+    goto exit_handler;
+  }
+
+  CpuNode = CpusNode;
+  for (Index = 0; Index < CpuCount; Index++) {
+    Status = FdtGetNextNamedNodeInBranch (Fdt, CpusNode, "cpu", &CpuNode);
+    if (EFI_ERROR (Status)) {
+      Status = EFI_UNSUPPORTED;
+      goto exit_handler;
+    }
+
+    CpuPhandles[Index] = FdtGetPhandle (Fdt, CpuNode);
+  }
+
+  Node                    = &Nodes[0];
+  Node->Token             = PROC_HIERARCHY_TOKEN (0);
+  Node->Flags             = PROC_HIERARCHY_FLAGS (EFI_ACPI_6_3_PPTT_PACKAGE_PHYSICAL, 0);
+  Node->ParentToken       = CM_NULL_TOKEN;
+  Node->AcpiIdObjectToken = CM_NULL_TOKEN;
+  NodeCount               = 1;
+
+  Status = EFI_SUCCESS;
+  for (ClusterNode = FdtFirstSubnode (Fdt, CpuMapNode);
+       ClusterNode >= 0;
+       ClusterNode = FdtNextSubnode (Fdt, ClusterNode))
+  {
+    if (NodeCount >= MaxNodes) {
+      Status = EFI_UNSUPPORTED;
+      goto exit_handler;
+    }
+
+    ClusterToken            = PROC_HIERARCHY_TOKEN (NodeCount);
+    Node                    = &Nodes[NodeCount++];
+    Node->Token             = ClusterToken;
+    Node->Flags             = PROC_HIERARCHY_FLAGS (0, 0);
+    Node->ParentToken       = Nodes[0].Token;
+    Node->AcpiIdObjectToken = CM_NULL_TOKEN;
+
+    for (CoreNode = FdtFirstSubnode (Fdt, ClusterNode);
+         CoreNode >= 0;
+         CoreNode = FdtNextSubnode (Fdt, CoreNode))
+    {
+      // Nested clusters and threads are not supported.
+      Data = FdtGetProp (Fdt, CoreNode, "cpu", &DataSize);
+      if ((Data == NULL) || (DataSize != sizeof (UINT32)) ||
+          (NodeCount >= MaxNodes))
+      {
+        Status = EFI_UNSUPPORTED;
+        goto exit_handler;
+      }
+
+      Phandle = Fdt32ToCpu (*(UINT32 *)Data);
+      for (Index = 0; Index < CpuCount; Index++) {
+        if (!Seen[Index] && (CpuPhandles[Index] == Phandle)) {
+          break;
+        }
+      }
+
+      if (Index == CpuCount) {
+        Status = EFI_UNSUPPORTED;
+        goto exit_handler;
+      }
+
+      Seen[Index]             = TRUE;
+      Node                    = &Nodes[NodeCount];
+      Node->Token             = PROC_HIERARCHY_TOKEN (NodeCount);
+      Node->Flags             = PROC_HIERARCHY_FLAGS (0, EFI_ACPI_6_3_PPTT_NODE_IS_LEAF);
+      Node->ParentToken       = ClusterToken;
+      Node->AcpiIdObjectToken = GicCTokens[Index];
+      NodeCount++;
+    }
+  }
+
+  // Every cpu must be in the map exactly once.
+  for (Index = 0; Index < CpuCount; Index++) {
+    if (!Seen[Index]) {
+      Status = EFI_UNSUPPORTED;
+      goto exit_handler;
+    }
+  }
+
+  for (Index = 0; Index < NodeCount; Index++) {
+    Status = AddSingleCmObjWithToken (
+               FdtParserHandle,
+               CREATE_CM_ARCH_COMMON_OBJECT_ID (EArchCommonObjProcHierarchyInfo),
+               &Nodes[Index],
+               sizeof (CM_ARCH_COMMON_PROC_HIERARCHY_INFO),
+               Nodes[Index].Token
+               );
+    if (EFI_ERROR (Status)) {
+      ASSERT (0);
+      goto exit_handler;
+    }
+  }
+
+exit_handler:
+  if (Status == EFI_UNSUPPORTED) {
+    DEBUG ((DEBUG_WARN, "FdtHwInfoParser: unsupported cpu-map, flat CPU topology.\n"));
+    Status = EFI_SUCCESS;
+  }
+
+  if (CpuPhandles != NULL) {
+    FreePool (CpuPhandles);
+  }
+
+  if (Seen != NULL) {
+    FreePool (Seen);
+  }
+
+  if (Nodes != NULL) {
+    FreePool (Nodes);
+  }
+
+  return Status;
+}
+
